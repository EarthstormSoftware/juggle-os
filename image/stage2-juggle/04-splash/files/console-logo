#!/usr/bin/python3
"""Draws the Juggle OS icon in the top left corner of the console (tty1), once for each CPU core, in a row above the
text (/etc/issue starts with blank lines to leave room for it, and the icons line up with the text's two-space indent).

The console is text, so the logo goes straight into the framebuffer, and is drawn again whenever the console has
drawn over it (a cleared screen, the screen waking from blanking). It is only drawn while tty1 is showing. The icon is
rendered at build time as raw RGB, flattened onto the console's black background (console-logo.rgb, with its width
and height in console-logo.size). When the console is turned (fbcon=rotate, the display's rotation), the framebuffer
isn't, so the logo is turned to match.
"""

import fcntl
import os
import struct
import time
from pathlib import Path

LOGO = Path("/usr/share/juggle/console-logo.rgb")
SIZE = Path("/usr/share/juggle/console-logo.size")
FRAMEBUFFER = Path("/dev/fb0")
FRAMEBUFFER_INFO = Path("/sys/class/graphics/fb0")
# How many quarter turns clockwise the console is turned
CONSOLE_ROTATION = Path("/sys/class/graphics/fbcon/rotate")
ACTIVE_TTY = Path("/sys/class/tty/tty0/active")
# The visible screen's size (the framebuffer can be bigger: HDMI is forced on, so it fits the larger of the two)
FBIOGET_VSCREENINFO = 0x4600
MARGIN = 16
GAP = 16
INTERVAL = 2


def pixel(r: int, g: int, b: int, bits_per_pixel: int) -> bytes:
    """A pixel in the framebuffer's format (16-bit RGB565 or 32-bit XRGB)."""
    if bits_per_pixel == 16:
        return (((r >> 3) << 11) | ((g >> 2) << 5) | (b >> 3)).to_bytes(2, "little")
    return bytes((b, g, r, 0xFF))


def screen_size() -> tuple[int, int]:
    with open(FRAMEBUFFER, "rb") as framebuffer:
        return struct.unpack("2I", fcntl.ioctl(framebuffer, FBIOGET_VSCREENINFO, bytes(160))[:8])


def console_rotation() -> int:
    try:
        return int(CONSOLE_ROTATION.read_text()) % 4
    except (OSError, ValueError):
        return 0


def logo_rows(bits_per_pixel: int, stride: int) -> list[tuple[int, bytes]]:
    """The logo's rows in the framebuffer, each as (where it starts, its pixels in the framebuffer's format): as many
    icons as there are cores, GAP apart, in the console's top left corner, however the console is turned."""
    xres, yres = screen_size()
    rotation = console_rotation()
    console_width = xres if rotation % 2 == 0 else yres
    width, height = map(int, SIZE.read_text().split())
    # As many as fit across the screen, so a narrow one doesn't wrap them onto the next lines
    fits = max(1, (console_width - 2 * MARGIN + GAP) // (width + GAP))
    count = min(os.cpu_count() or 1, fits)
    rgb = LOGO.read_bytes()
    icon = [pixel(*rgb[i:i + 3], bits_per_pixel) for i in range(0, width * height * 3, 3)]
    black = pixel(0, 0, 0, bits_per_pixel)

    def colour(x: int, y: int) -> bytes:
        """The pixel at x, y in the row of icons."""
        x %= width + GAP
        return icon[y * width + x] if x < width else black

    # A point on the console to the framebuffer, and back
    to_screen = [lambda x, y: (x, y), lambda x, y: (xres - 1 - y, x),
                 lambda x, y: (xres - 1 - x, yres - 1 - y), lambda x, y: (y, yres - 1 - x)][rotation]
    to_console = [lambda x, y: (x, y), lambda x, y: (y, xres - 1 - x),
                  lambda x, y: (xres - 1 - x, yres - 1 - y), lambda x, y: (yres - 1 - y, x)][rotation]
    right, bottom = MARGIN + count * width + (count - 1) * GAP - 1, MARGIN + height - 1
    corners = [to_screen(x, y) for x in (MARGIN, right) for y in (MARGIN, bottom)]
    left, top = min(x for x, _ in corners), min(y for _, y in corners)
    across, down = max(x for x, _ in corners), max(y for _, y in corners)
    rows = []
    for y in range(top, down + 1):
        row = b"".join(colour(cx - MARGIN, cy - MARGIN)
                       for cx, cy in (to_console(x, y) for x in range(left, across + 1)))
        rows.append((y * stride + left * bits_per_pixel // 8, row))
    return rows


def main() -> None:
    while not FRAMEBUFFER.exists():
        time.sleep(INTERVAL)
    bits_per_pixel = int((FRAMEBUFFER_INFO / "bits_per_pixel").read_text())
    stride = int((FRAMEBUFFER_INFO / "stride").read_text())
    rows = logo_rows(bits_per_pixel, stride)

    with open(FRAMEBUFFER, "r+b", buffering=0) as framebuffer:
        while True:
            if ACTIVE_TTY.read_text().strip() == "tty1":
                for position, row in rows:
                    framebuffer.seek(position)
                    if framebuffer.read(len(row)) != row:
                        for position_, row_ in rows:
                            framebuffer.seek(position_)
                            framebuffer.write(row_)
                        break
            time.sleep(INTERVAL)


if __name__ == "__main__":
    main()
