[Unit]
Description=Juggle OS logo on the console
After=getty@tty1.service plymouth-quit.service
# Not while an app draws on the screen (as getty@tty1)
ConditionPathExists=!/run/juggle/display

[Service]
ExecStart=/usr/lib/juggle/console-logo
Restart=on-failure
RestartSec=10
Nice=10

[Install]
WantedBy=multi-user.target
